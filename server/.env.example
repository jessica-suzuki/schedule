# Conexão com o banco PostgreSQL "normal" (sem Supabase).
# Exemplo local: postgresql://usuario:senha@localhost:5432/clinica_app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinica_app

# Segredo usado para assinar os tokens de login (JWT). Troque por um valor
# aleatório e privado em produção (ex.: openssl rand -hex 32).
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio

# Por quanto tempo o login fica válido antes de precisar entrar de novo.
JWT_EXPIRES_IN=7d

# Porta em que a API vai rodar.
PORT=3001

# Origem(ns) do frontend que podem chamar esta API (CORS).
# Em desenvolvimento o Vite normalmente roda em http://localhost:5173.
CORS_ORIGIN=http://localhost:5173

# E-mail transacional (Resend, https://resend.com) usado para o link de
# "esqueci minha senha". Crie uma API key em resend.com/api-keys.
RESEND_API_KEY=

# Remetente do e-mail. Sem domínio verificado no Resend, use o domínio de
# testes deles (só entrega para o e-mail da própria conta Resend):
RESET_EMAIL_FROM=onboarding@resend.dev

# Página do frontend que recebe o token e deixa a pessoa digitar a nova
# senha. Troque para a URL de produção quando fizer o deploy.
RESET_URL_BASE=http://localhost:5173/admin/redefinir-senha
